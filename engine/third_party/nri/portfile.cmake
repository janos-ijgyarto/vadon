vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO NVIDIA-RTX/NRI
    REF "v191"
    SHA512 0c5af27e6f0850481c54f7ec168313c53256c54dc7b1ec5ff7aee8c33d429b3b8eba8efe527515c679fdbc68fdffd432e24fd5f8a30a1c793b5443abef66a290
	HEAD_REF main
)

vcpkg_cmake_configure(
    SOURCE_PATH "${SOURCE_PATH}"
	OPTIONS
		-DNRI_STATIC_LIBRARY=ON
        -DNRI_ENABLE_D3D12_SUPPORT=ON
        -DNRI_ENABLE_VK_SUPPORT=OFF
        -DNRI_ENABLE_D3D11_SUPPORT=OFF
        -DNRI_ENABLE_WGPU_SUPPORT=OFF
        -DNRI_ENABLE_METAL_SUPPORT=OFF
        -DNRI_ENABLE_NONE_SUPPORT=OFF
        
		-DNRI_ENABLE_IMGUI_EXTENSION=OFF
        -DNRI_ENABLE_NIS_SDK=OFF
		-DNRI_ENABLE_AMDAGS=OFF
		-DNRI_ENABLE_NVAPI=OFF
		
        -DNRI_ENABLE_DEBUG_NAMES_AND_ANNOTATIONS=OFF
        -DNRI_ENABLE_VALIDATION_SUPPORT=OFF
		-DNRI_ENABLE_NVTX_SUPPORT=OFF
		
		# FIXME: find a way to avoid using FetchContent
        # and gather dependencies via vcpkg
		-DFETCHCONTENT_FULLY_DISCONNECTED=OFF
		
		
	OPTIONS_RELEASE		
		-DCMAKE_RUNTIME_OUTPUT_DIRECTORY=${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-rel/bin
        -DCMAKE_LIBRARY_OUTPUT_DIRECTORY=${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-rel/lib
        -DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-rel/lib
		
	OPTIONS_DEBUG		
		-DCMAKE_RUNTIME_OUTPUT_DIRECTORY=${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-dbg/bin
        -DCMAKE_LIBRARY_OUTPUT_DIRECTORY=${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-dbg/lib
        -DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-dbg/lib
)

vcpkg_cmake_build()

file(INSTALL "${SOURCE_PATH}/Include/" DESTINATION "${CURRENT_PACKAGES_DIR}/include/nri")

file(INSTALL "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-dbg/lib/" DESTINATION "${CURRENT_PACKAGES_DIR}/debug/lib")
file(INSTALL "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-rel/lib/" DESTINATION "${CURRENT_PACKAGES_DIR}/lib")

file(INSTALL "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-dbg/bin/NRI.lib" DESTINATION "${CURRENT_PACKAGES_DIR}/debug/lib")
file(INSTALL "${CURRENT_BUILDTREES_DIR}/${TARGET_TRIPLET}-rel/bin/NRI.lib" DESTINATION "${CURRENT_PACKAGES_DIR}/lib")